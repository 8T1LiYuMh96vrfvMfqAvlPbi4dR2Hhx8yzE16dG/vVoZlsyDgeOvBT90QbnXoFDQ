Sections.Farming:CreateToggle({
    Text = "Patrol";
    Callback = function(Value)
        Loop("RenderStepped", "Patrol", Value, function()
            local Areas = Locator.Areas;
            local Selected = {};

            for _, Name in pairs(Patrol.Regions) do
                if Areas[Name] then
                    table.insert(Selected, Areas[Name].Grid);
                end;
            end;

            if #Selected == 0 then return; end;

            Patrol.Progress = Patrol.Progress or 1;
            Patrol.Section = Patrol.Section or 1;

            local Grid = Selected[Patrol.Progress];

            if not Grid or Patrol.Section > #Grid then
                Patrol.Section = 1;
                Patrol.Progress = Patrol.Progress % #Selected + 1;
                Grid = Selected[Patrol.Progress];
            end;

            local Section = Grid[Patrol.Section];
            if not Section then
                Patrol.Section = 1;
                Patrol.Progress = Patrol.Progress % #Selected + 1;
                return;
            end;

            local Center = Section.Center;
            local Origin = vector.create(Center.X, 1000, Center.Y);
            local Result = workspace:Raycast(Origin, Vector3.new(0, -2000, 0));

            local Y = Result and Result.Position.Y + 3 or HRP.Position.Y;

            if Tween:Create({Priority=1, Position = vector.create(Center.X, Y, Center.Y), Speed = TweenSpeed}) then
                Patrol.Section += 1;
            end;
        end);
    end;

    Flag = "patrol"
});

