--; Helpers
local Mobs = {};
local function addFolder(Folder)
    local Name = Folder.Name:gsub("%s", "");
    local List = Mobs[Name] or {Spawned = {}};

    Mobs[Name] = List;

    local Info = Folder:FindFirstChild("BossInfo");
    List.Location = Info and Info:GetAttribute("Center");

    local function Add(v)
        if not v:IsA("Model") or table.find(List.Spawned, v) then return; end;

        table.insert(List.Spawned, v);

        v.AncestryChanged:Once(function()
            local Index = table.find(List.Spawned, v);
            if Index then
                table.remove(List.Spawned, Index);
            end;
        end);
    end;

    for _, v in ipairs(Folder:GetChildren()) do
        Add(v);
    end;

    Maid:GiveTask(Folder.ChildAdded:Connect(Add));
end;

for _, Region in ipairs(Regions:GetChildren()) do
	local Active = Region:FindFirstChild("ActiveNpcs");

	if Active then
		for _, Folder in ipairs(Active:GetChildren()) do
			addFolder(Folder);
		end;

		local c1 = Active.ChildAdded:Connect(addFolder);
        Maid:GiveTask(function() c1:Disconnect(); end);
	end;
end;

local function getMobs(Targets)
    if not Targets then return Mobs; end;

	local Result = {};
	for _, Name in ipairs(Targets) do
		if Mobs[Name] then
			Result[Name] = Mobs[Name];
		end;
	end;

	return Result;
end;

local Last, At, Attempted = 0, 0, nil;
local function Attack()
    local Combo = (Char:GetAttribute("last_combo") or 0)%5 + 1;

    local Tool = Info.Get_equipped_tool(Char);
    local P = (Tool and Combat.Presets[Tool.Name]) or Combat.Presets.Combat;
    local Base = 0;
    if Last ~= 0 then
        if Combo == 1 then
            Base = Last == 5 and P.final or Combat.combo_duration;
        else
            Base = (P.customDelay and P.customDelay[Combo]) or P.default;
        end;
    end;
    
    local Wait = Base / Combat.attackSpeedMult(client);
    local Lead = (Combo == 1) and -0.05 or client:GetNetworkPing();
    local Rest = At + Wait - Lead - os.clock();

    if Rest > 0 then return; end;
    Signal:FireServer("Combat_Service", "Combat", Combo, false, 0.13, false, nil);

    At = os.clock();
    Last = Combo;

    return true;
end;








