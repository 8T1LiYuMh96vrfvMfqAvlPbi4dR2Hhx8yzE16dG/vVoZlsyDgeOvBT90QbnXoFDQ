Sections.Farming:CreateToggle({
    Text = "Mob Farm"; 
    Flag = "mob_farm";
    Callback = function(Value)
        Loop("RenderStepped", "mob_farm", Value, function()
            local Targets = getMobs((not Farm.Ignore and Farm.Mobs));
            local Alive, Indexed = {}, {};
            local Bosses = {};

            for _, v in pairs(Targets) do -- Gather mobs
                if #v.Spawned > 0 then 
                    for _, Spawned in pairs(v.Spawned) do
                        if not Spawned.Parent then continue; end;
                        table.insert(Alive, Spawned);

                        if v.Location then
                            table.insert(Bosses, Spawned);
                        end;
                    end;
                end;


                table.insert(Indexed, v);
            end;

            if #Alive > 0 then
                local Target = Utils.GetNearest(Alive);

                local Root = Target.HumanoidRootPart or Target.PrimaryPart;
                local Position = (Root.CFrame * Farm.Offset).Position;
                
                if Tween:Create({Priority=2, Continue=true, Position=CFrame.lookAt(Position, Root.Position), Speed=TweenSpeed}) then
                    Farm.Position = Root.Position;
                    Attack();

                    if IK.Enabled then
                        if not IK.Bosses and table.find(Bosses, Target) then print("boss"); return; end;

                        local mhum = Target:FindFirstChild("Humanoid", true);
                        mhum.Health=0;
                    end;
                end;
            else
                if Farm.Position then
                    if Tween:Create({Priority=2, Position=Farm.Position, Speed=TweenSpeed}) then
                        Farm.Position = nil;
                    end;

                    return;
                end;

                Target=Target or 1;
                local Mob = Indexed[Target];
                local Found = false;
                if not Mob then return; end;
                local Spawn = Mob.Location; 
                if not Spawn then return; 
                else 
                    if not Tween:Create({Position=Spawn-vector.create(0, 50, 0), Speed=TweenSpeed}) then
                        Found=true;
                    end;
                end;

                if not Found then Target=(Target%#Indexed)+1; end;
            end;
        end);

        if not Value then Tween:Cancel(); end;
    end;
});

