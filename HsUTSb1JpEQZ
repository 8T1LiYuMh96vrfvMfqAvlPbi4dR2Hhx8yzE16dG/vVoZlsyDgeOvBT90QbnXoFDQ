Setup["InputRecorder"] = function(self)
    local Manager = {};
    if Called["InputRecorder"] then return Called["InputRecorder"]; end;
    Called["InputRecorder"] = Manager;

    self:Basics();

    Manager.Pressed = {};
    function Manager:Record(OnUP, Settings)
        if not Settings then return; end;
        local Callback = Settings['Callback'];
        local Valid = Settings['Inputs'];
        local Type = Settings['Type'];
        local Break = Settings['Break'];
        local CancelKeys = Settings['CancelKeys'] or { "Escape", "Backspace" };
        local IgnoreProc = Settings['IgnoreProc'];
        local Recorder;

        if not Callback then return; end;

        local function OnResponse(Input, isTyping)
            if (not Input) or (isTyping and not IgnoreProc) then return; end;

            local Keycode = Input['KeyCode'];
            local UserInputType = Input['UserInputType'];
            if not Keycode then return; end;
            local KeyName = Keycode.Name;

            if KeyName == "Unknown" then
                if Type == "KeyCode" then return; end;

                KeyName = UserInputType.Name;
            end;

            if table.find(CancelKeys, KeyName) then
                if Recorder then
                    Recorder:Disconnect();
                    Callback();
                    return;
                end;
            end;

            if Valid then
                if table.find(Valid, KeyName) then
                    Callback(KeyName);
                else
                    for i, v in next, (Valid) do
                        if string.lower(v) == string.lower(KeyName) then
                            Callback(KeyName);
                        end;
                    end;
                end;
            else
                Callback(KeyName);
            end;

            if Break and Recorder then
                Recorder:Disconnect();
            end;
        end;

        if OnUP then
            Recorder = UserInputService.InputEnded:Connect(OnResponse);
        else
            Recorder = UserInputService.InputBegan:Connect(OnResponse);
        end;

        return Recorder;
    end;

    function Manager:Bind(Key, Callback, OnUP, IgnoreProc)
        if (not Key) or (not Callback) then return; end;

        return Manager:Record(OnUP, {
            Inputs = (typeof(Key) == "table" and Key) or { Key },
            CancelKeys = {},
            IgnoreProc = IgnoreProc,

            Callback = Callback,
        });
    end;

    UserInputService.InputBegan:Connect(function(Input, proc)
        if not proc then
            local Keycode = Input['KeyCode'];
            local UserInputType = Input['UserInputType'];
            if not Keycode then return; end;
            local KeyName = Keycode.Name;

            if KeyName == "Unknown" then
                if Type == "KeyCode" then return; end;

                KeyName = UserInputType.Name;
            end;
        end;
    end);

    UserInputService.InputEnded:Connect(function(Input, proc)
        if not proc then
            local Keycode = Input['KeyCode'];
            local UserInputType = Input['UserInputType'];
            if not Keycode then return; end;
            local KeyName = Keycode.Name;

            if KeyName == "Unknown" then
                if Type == "KeyCode" then return; end;

                KeyName = UserInputType.Name;
            end;
        end;
    end);

    return Manager;
end;

Setup["Hooking"] = function(self)
    local Manager = {};
    if Called["Hooking"] then return Called["Hooking"]; end;
    Called["Hooking"] = Manager;

    local Hooks = {};
    local function AttemptHook(Instance, Method, ...)
        local Hook = Hooks[Instance];
        if Hook and Hook[1] == Method then
            return Hook[2](...) or nil;
        end;
    end;

    function Manager.Add(Instance, Method, Response)
        if Hooks[Instance] then return; end;
        return pcall(function() Hooks[Instance] = {Method, Response} end);
    end;

    function Manager.Remove(Instance)
        return pcall(function() Hooks[Instance] = nil; end);
    end;

    function Manager.Exists(Instance)
        return Hooks[Instance] ~= nil;
    end;

    local old;
    old = hookmetamethod(game, "__namecall", function(self, ...)
        if not checkcaller() then
            local Response = AttemptHook(self, getnamecallmethod(), ...); -- 0 = Return, 
            if Response == 0 then return; end;
        end;

        return old(self, ...);
    end);

    return Manager;
end;

Setup["Maid"] = function(self)
    local Manager = {};
    if Called["Maid"] then return Called["Maid"]; end;
    Called["Maid"] = Manager;

    function Manager.new()
        local Maid = {
            Tasks = {};
        }
        function Maid:GiveTask(task)
            table.insert(self.Tasks, task);
        end;

        function Maid:DoCleaning()
            for _, task in ipairs(self.Tasks) do
                if typeof(task) == "RBXScriptConnection" then
                    task:Disconnect();
                elseif typeof(task) == "Instance" then
                    task:Destroy();
                elseif type(task) == "function" then
                    task();
                end;
            end;

            table.clear(self.Tasks);
        end;
        
        return Maid;
    end;

    return Manager;
end;

Setup["Loop"] = function(self)
    local Manager = {};
    if Called["Loop"] then return Called["Loop"]; end;
    Called["Loop"] = Manager;
    Setup:Basics();
    
    local Connections; Connections = {
        Heartbeat = {
            List = {};
            History = { };

            _Connection = RSV.Heartbeat:Connect(function(dt)
                local Self = Connections.Heartbeat;
                for i, v in pairs(Self.List) do
                    if typeof(v) == "table" then
                        local f, t = table.unpack(v);

                        local p = Self.History[i];
                        if p then
                            if os.time()-p < t then return; end;
                        end;

                        Self.History[i] = os.time();
                        task.spawn(f, dt);
                    else
                        task.spawn(v, dt);
                    end;
                end;
            end);
        };

        RenderStepped = {
            List = {};
            History = { };

            _Connection = RSV.RenderStepped:Connect(function(dt)
                local Self = Connections.RenderStepped;
                for _, v in pairs(Self.List) do
                    if typeof(v) == "table" then
                        local f, t = table.unpack(v);
                        
                        local p = Self.History[i];
                        if p then
                            if os.time()-p < t then return; end;
                        end;

                        Self.History[i] = os.time();
                        task.spawn(f, dt);
                    else
                        task.spawn(v, dt);
                    end;
                end;
            end);
        };
    };

    local Storage = {};
    setmetatable(Manager, {
        __call = function(self, Connection, Key, Value, Data)
            local ct = Connections[Connection];
            if not ct then return warn("Invalid Loop Connection"); end;

            if Value then
                ct.List[Key] = Data;
            else
                ct.List[Key] = nil;
            end;
        end;
    });

    function Manager.Kill()
        for _, v in pairs(Connections) do 
            v._Connection:Disconnect();
            Called["Loop"] = nil;
        end;
    end;

    return Manager;
end;

Setup["Utils"] = function(self)
    local Manager = {};
    if Called["Utils"] then return Called["Utils"]; end;
    Called["Utils"] = Manager;
    Setup:Basics();

    function Manager.GetDist(p1, p2)
        local function Check(p)
            if typeof(p) == "Vector3" then return p; 
            elseif typeof(p) == "CFrame" then return p.Position;
            elseif typeof(p) == "Instance" and p:IsA("BasePart") then return p.Position;
            else return p; end;
        end;

        p1, p2 = Check(p1), Check(p2);
        return (p1 - p2).Magnitude;
    end;

    function Manager.Combine(t1,t2) 
        local nt = table.clone(t1);
        for _, v in pairs(t2) do
            table.insert(nt, v);
        end;
        return nt;
    end;

    function Manager.GetNearest(t, checkvisible)
        if typeof(t) == "Instance" then t=t:GetChildren(); end;
        if typeof(t) ~= "table" then return; end;
        
        local Closest, Dist = nil, math.huge
        for _, v in pairs(t) do
            if typeof(v) == "Vector3" then
                local nDist = (HRP.Position - v).Magnitude;

                if nDist < Dist then
                    Closest = v;
                    Dist = nDist;
                end;
            else
                local tHumanoid = v:FindFirstChildOfClass('Humanoid');
                local tHRP = v:FindFirstChild('HumanoidRootPart');
                if v:IsA("Model") and tHumanoid then
                    if v~=Character and tHRP and HRP and not v:FindFirstChildOfClass("ForceField") then
                        if checkvisible and not Actions.Misc.isVisible(tHRP) then continue; end;

                        local nDist = (HRP.Position - tHRP.Position).Magnitude;

                        if nDist < Dist then
                            Closest = v;
                            Dist = nDist;
                        end;
                    end;
                elseif v:IsA("Part") then
                    local nDist = (HRP.Position - v.Position).Magnitude;

                    if nDist < Dist then
                        Closest = v;
                        Dist = nDist;
                    end;
                end;
            end;
        end;

        return Closest;
    end;

    function Manager.WithName(name, t)
        if typeof(t) == "Instance" then t=t:GetChildren(); end;
        if typeof(t) ~= "table" then return; end;

        local Group = { };
        for i, v in pairs(t) do
            if v.Name:match(name) then
                table.insert(Group, v);
            end;
        end;

        return Group;
    end;

    function Manager.InRange(t, range, part)
        if typeof(t) == "Instance" then t=t:GetChildren(); end;
        if typeof(t) ~= "table" then return; end;
        
        local range=range or 10;
        local Group = { };
        for i, v in pairs(t) do
            local tHumanoid = v:FindFirstChildOfClass('Humanoid');
            local tHRP = v:FindFirstChild('HumanoidRootPart');

            if v~=Character and tHumanoid and tHRP and HRP then
                local dist = (HRP.Position - tHRP.Position).Magnitude;

                if dist < range then
                    if part then
                        local found = v:FindFirstChild(part);
                        if found then table.insert(Group, found); end;
                    else
                        table.insert(Group, v);
                    end;
                end;
            end;
        end;

        return Group;
    end;

    function Manager.isVisible(target)
        local targetPosition;
        if typeof(target) == "Vector3" then
            targetPosition = target;
        elseif target:IsA("Model") then
            targetPosition = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart or target:GetPivot().Position;
        elseif target:IsA("BasePart") then
            targetPosition = target.Position;
        else
            return nil;
        end;

        local direction = targetPosition - HRP.Position;

        local params = RaycastParams.new();
        params.FilterType = Enum.RaycastFilterType.Blacklist;
        params.FilterDescendantsInstances = { Character };
        params.IgnoreWater = true;

        local result = workspace:Raycast(HRP.Position, direction, params);
        return result;
    end;

    function Manager.getnil(name, ty, parent)
        local parent = parent or game;
        for _, v in pairs(parent:GetDescendants()) do
            if (not name or v.Name == name) and (not ty or v:IsA(ty)) then
                return v;
            end;
        end;
    end;

    return Manager;
end;

return Setup;
